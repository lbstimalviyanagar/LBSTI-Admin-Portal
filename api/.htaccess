Options -Indexes
RewriteEngine On
RewriteBase /api/

<FilesMatch "^(config|cors)\.php$">
  Require all denied
</FilesMatch>

RewriteRule ^auth/login/?$ auth.php [QSA,L]
RewriteRule ^enquiries/([0-9]+)/remarks/?$ enquiries.php?id=$1&resource=remarks [QSA,L]
RewriteRule ^enquiries/([0-9]+)/confirm/?$ enquiries.php?id=$1&action=confirm [QSA,L]
RewriteRule ^enquiries/([0-9]+)/?$ enquiries.php?id=$1 [QSA,L]
RewriteRule ^enquiries/?$ enquiries.php [QSA,L]
RewriteRule ^students/?$ students.php [QSA,L]
RewriteRule ^fees/([0-9]+)/?$ fees.php?id=$1 [QSA,L]
RewriteRule ^fees/?$ fees.php [QSA,L]
RewriteRule ^payments/([0-9]+)/?$ payments.php?id=$1 [QSA,L]
RewriteRule ^payments/?$ payments.php [QSA,L]
RewriteRule ^receipts/?$ receipts.php [QSA,L]
