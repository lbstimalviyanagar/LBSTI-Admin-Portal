# Server configuration
PORT=5000
NODE_ENV=production

# Exact deployed frontend origin(s), comma-separated when needed.
FRONTEND_URL=https://your-frontend.example.com

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Choose one hosted database configuration. Local SQLite is development-only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# For hosted MySQL, use DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Or configure these variables instead:
# DATABASE_HOST=db.example.com
# DATABASE_PORT=3306
# DATABASE_USER=u123456_admin
# DATABASE_PASSWORD=your_password
# DATABASE_NAME=u123456_lbstiadmin

# Optional first-run admin bootstrap. Prefer the create-user script, then remove these.
# DEFAULT_ADMIN_USERNAME=
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_ADMIN_NAME=
